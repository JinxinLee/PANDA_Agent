# Normalize source and documentation files to LF in the repository.
* text=auto eol=lf
*.py text eol=lf
*.pyi text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.bat text eol=lf
*.ps1 text eol=lf
*.xml text eol=lf
*.csv text eol=lf
*.tsv text eol=lf

