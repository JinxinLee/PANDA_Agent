# Vertex AI (never commit real credentials)
QA_GCP_PROJECT_ID=your-gcp-project-id
QA_VERTEX_LOCATION=global
QA_GENERATION_MODEL_ID=gemini-3.7-flash
QA_EVALUATION_JUDGE_MODEL_ID=gemini-3.7-flash
QA_EMBEDDING_MODEL_ID=gemini-embedding-2
QA_EMBEDDING_DIMENSIONS=3072
QA_VERTEX_TIMEOUT_MS=120000

# Local PostgreSQL and Qdrant
PANDA_POSTGRES_PASSWORD=replace-for-shared-environments
PANDA_DATABASE_URL=postgresql://panda:replace-for-shared-environments@127.0.0.1:55432/panda_qa
PANDA_QDRANT_URL=http://127.0.0.1:6333
PANDA_QDRANT_COLLECTION=panda_knowledge_v1
COMPOSE_PROJECT_NAME=panda_qa_bundle
PANDA_API_MAX_CONCURRENCY=1
PANDA_QA_DEADLINE_SECONDS=300
PANDA_READINESS_TTL_SECONDS=5
PANDA_LOG_LEVEL=INFO

# Local FastEmbed BM25 runtime asset (resolved relative to PANDA_Agent project root)
PANDA_FASTEMBED_MODEL_PATH=data/runtime/fastembed/bm25
